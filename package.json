{
  "name": "govbid-pro-client",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/GovBidPro.BrowserTests/tsconfig.json --noEmit",
    "build:client": "tsc -p tsconfig.json",
    "watch:client": "tsc -p tsconfig.json --watch",
    "test:browser": "playwright test -c tests/GovBidPro.BrowserTests/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.6",
    "typescript": "5.9.3"
  }
}
