{
  "ConnectionStrings": {
    "GovBidPro": "Host=localhost;Port=5432;Database=govbidpro;Username=govbid;Password=govbid_local_dev"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Security": {
    "AllowInsecureLocalHttp": true
  },
  "Identity": {
    "RequireConfirmedAccount": false
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "../../.local-storage"
  },
  "Documents": {
    "MalwareScanMode": "DevelopmentBypass"
  },
  "Retention": {
    "PurgeJob": {
      "Enabled": true,
      "IntervalMinutes": 15
    }
  },
  "OpportunitySources": {
    "Fixture": {
      "ImportOnStartup": true
    }
  }
}
