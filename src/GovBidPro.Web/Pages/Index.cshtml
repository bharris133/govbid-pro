@page
@model GovBidPro.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}
<section class="hero">
    <h1>GovBid Pro</h1>
    <p>Find public government opportunities, track notice details and deadlines, and prepare responses with your team.</p>
    <p class="notice">This is an early build. Opportunity data shown here is <strong>demo fixture data</strong>, not live government data. A live SAM.gov integration has not been verified yet.</p>
    <p><a class="button" href="/Opportunities">Browse opportunities</a></p>
</section>
<section>
    <h2>What GovBid Pro does not do</h2>
    <ul>
        <li>It does not submit proposals to SAM.gov or any agency. You submit following the solicitation's instructions.</li>
        <li>It does not certify compliance, eligibility (including VetCert) or guarantee contract awards.</li>
        <li>It is not authorized to handle FCI, CUI or classified information. See the <a href="/DataPolicy">data policy</a>.</li>
        <li>AI features are turned off.</li>
    </ul>
</section>
