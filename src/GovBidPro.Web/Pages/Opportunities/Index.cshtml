@page
@model GovBidPro.Web.Pages.Opportunities.IndexModel
@{
    ViewData["Title"] = "Opportunities";
    ViewData["Page"] = "opportunities";
}
<h1>Opportunities</h1>
<div id="source-status" class="notice" role="status" aria-live="polite">Loading source status…</div>

<form id="opportunity-filters" class="filters" aria-label="Filter opportunities">
    <div class="field">
        <label for="f-keywords">Keywords</label>
        <input id="f-keywords" name="keywords" type="search" autocomplete="off" />
    </div>
    <div class="field">
        <label for="f-naics">NAICS code</label>
        <input id="f-naics" name="naics" inputmode="numeric" pattern="[0-9]{2,6}" />
    </div>
    <div class="field">
        <label for="f-agency">Agency contains</label>
        <input id="f-agency" name="agency" />
    </div>
    <div class="field">
        <label for="f-state">Place of performance (state)</label>
        <input id="f-state" name="state" maxlength="2" />
    </div>
    <div class="field">
        <label for="f-notice">Source notice type</label>
        <select id="f-notice" name="noticeType">
            <option value="">Any</option>
            <option value="PreSolicitation">Presolicitation</option>
            <option value="Solicitation">Solicitation</option>
            <option value="CombinedSynopsisSolicitation">Combined synopsis/solicitation</option>
            <option value="SourcesSought">Sources sought</option>
            <option value="SpecialNotice">Special notice</option>
            <option value="AwardNotice">Award notice</option>
            <option value="SoleSource">Sole source</option>
        </select>
    </div>
    <div class="field">
        <label for="f-response">Response type</label>
        <select id="f-response" name="responseType">
            <option value="">Any</option>
            <option value="Rfp">RFP</option>
            <option value="Rfq">RFQ</option>
            <option value="Rfi">RFI</option>
            <option value="SourcesSought">Sources sought</option>
            <option value="Undetermined">Undetermined</option>
            <option value="NoResponseExpected">No response expected</option>
        </select>
    </div>
    <div class="actions">
        <button type="submit">Search</button>
    </div>
</form>

<section aria-labelledby="save-heading" class="panel">
    <h2 id="save-heading">Save this search</h2>
    <form id="save-search" class="inline-form">
        <label for="s-name">Name</label>
        <input id="s-name" name="name" required maxlength="120" />
        <button type="submit">Save search</button>
    </form>
    <p id="save-status" role="status" aria-live="polite"></p>
    <h3>Saved searches</h3>
    <ul id="saved-searches"><li>Loading…</li></ul>
</section>

<section aria-labelledby="results-heading">
    <h2 id="results-heading">Results</h2>
    <p id="results-summary" role="status" aria-live="polite"></p>
    <div id="results"></div>
</section>
