{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "GovBidPro": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Identity": {
    "RequireConfirmedAccount": true
  },
  "Storage": {
    "Provider": "AzureBlob",
    "ContainerName": "documents"
  },
  "Documents": {
    "MaxUploadBytes": 26214400,
    "MaxDocumentsPerTenant": 5000,
    "MalwareScanMode": "NotConfigured",
    "ClamAv": {
      "Host": "",
      "Port": 3310,
      "TimeoutSeconds": 60
    },
    "Rescan": {
      "Enabled": true,
      "IntervalMinutes": 15,
      "BatchSize": 50
    }
  },
  "Email": {
    "Provider": "None",
    "FromAddress": "",
    "FromName": "GovBid Pro",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseTls": true,
      "Username": "",
      "TimeoutSeconds": 30
    }
  },
  "Collaboration": {
    "InvitationExpiryDays": 7,
    "MinimumRoleToInvite": "CompanyAdmin",
    "MinimumRoleToManageMembers": "CompanyAdmin",
    "RequireConfirmedEmailToAcceptInvitation": true,
    "EmailNotificationsEnabled": true,
    "PublicBaseUrl": "",
    "Alerts": {
      "Enabled": true,
      "IntervalMinutes": 60,
      "DailyEveryHours": 24,
      "WeeklyEveryDays": 7,
      "MaxItemsPerAlert": 20
    }
  },
  "DataHandling": {
    "ConfidentialCommercialAiApproved": false
  },
  "Ai": {
    "PlatformEnabled": false,
    "Provider": "None",
    "Ai01ApprovalReference": null,
    "AllowedProviders": [],
    "EnabledFeatures": []
  },
  "Retention": {
    "ApprovalStatus": "provisional (owner decision D-02); legal review pending (LEG-01)",
    "Policies": {
      "active-documents": { "RetainWhileAccountActive": true },
      "deleted-document-recovery": { "Days": 30 },
      "closed-account-export": { "Days": 30 },
      "database-backups": { "Days": 30 },
      "security-audit-events": { "Days": 365 },
      "ai-request-metadata": { "Days": 90 }
    },
    "PurgeJob": {
      "Enabled": false,
      "IntervalMinutes": 60,
      "BatchSize": 100
    }
  },
  "OpportunitySources": {
    "Fixture": {
      "ImportOnStartup": false
    },
    "SamGov": {
      "Enabled": false,
      "BaseUrl": "https://api.sam.gov/opportunities/v2/search",
      "PageSize": 100,
      "LookbackDays": 2,
      "RequestTimeoutSeconds": 30,
      "OffsetMode": "PageIndex"
    },
    "Sync": {
      "Enabled": false,
      "IntervalMinutes": 360,
      "MaxPagesPerRun": 5
    }
  },
  "Assessments": {
    "MinimumRoleForDecision": "TeamManager",
    "MinimumRoleForProfile": "TeamManager"
  },
  "Proposals": {
    "MinimumRoleForFinalStages": "TeamManager",
    "AllowOwnerSelfReview": false,
    "RequireMandatoryRequirementsResolved": true,
    "StageLabels": {},
    "SectionTemplates": {}
  },
  "RateLimiting": {
    "RequestsPerMinute": 300,
    "LoginPerMinute": 10
  }
}
