{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "GovBidPro": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Identity": {
    "RequireConfirmedAccount": true
  },
  "Storage": {
    "Provider": "AzureBlob",
    "ContainerName": "documents"
  },
  "Documents": {
    "MaxUploadBytes": 26214400,
    "MaxDocumentsPerTenant": 5000,
    "MalwareScanMode": "NotConfigured"
  },
  "DataHandling": {
    "ConfidentialCommercialAiApproved": false
  },
  "Ai": {
    "PlatformEnabled": false,
    "Provider": "None",
    "Ai01ApprovalReference": null,
    "AllowedProviders": [],
    "EnabledFeatures": []
  },
  "Retention": {
    "ApprovalStatus": "provisional (owner decision D-02); legal review pending (LEG-01)",
    "Policies": {
      "active-documents": { "RetainWhileAccountActive": true },
      "deleted-document-recovery": { "Days": 30 },
      "closed-account-export": { "Days": 30 },
      "database-backups": { "Days": 30 },
      "security-audit-events": { "Days": 365 },
      "ai-request-metadata": { "Days": 90 }
    },
    "PurgeJob": {
      "Enabled": false,
      "IntervalMinutes": 60,
      "BatchSize": 100
    }
  },
  "OpportunitySources": {
    "Fixture": {
      "ImportOnStartup": false
    }
  },
  "RateLimiting": {
    "RequestsPerMinute": 300,
    "LoginPerMinute": 10
  }
}
