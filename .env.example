# GovBid Pro local development settings for Docker Compose (compose.yaml).
#
# Copy this file to .env, or just run .\start-local.ps1, which creates .env for you and
# replaces the password placeholder with a random value.
#
# .env is ignored by Git. Never commit it, and never put real credentials in this example file.
# Nothing here is used outside your own machine. No Azure, SAM.gov or AI keys are needed locally.

# Password for the local PostgreSQL container. Placeholder only: start-local.ps1 generates a
# random value. PostgreSQL stores the password in its data volume the first time it starts, so
# changing it later requires .\reset-local.ps1 (which deletes local data).
GOVBID_LOCAL_DB_PASSWORD=replace-me-start-local-generates-this

# Host ports, bound to 127.0.0.1 only. Change one if the port is already in use.
GOVBID_WEB_PORT=8080
GOVBID_DB_PORT=5432
